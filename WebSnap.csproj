<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>websnap</AssemblyName>
    <RootNamespace>WebSnap</RootNamespace>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <PropertyGroup>
    <Version>1.0.0</Version>
    <Product>WebSnap</Product>
    <AssemblyTitle>WebSnap web page screenshot tool</AssemblyTitle>
    <Company>WebSnap contributors</Company>
    <Description>Captures web page screenshots with Playwright.</Description>
    <Copyright>Copyright (c) 2026 WebSnap contributors</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Playwright" Version="1.59.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.15" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.15" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="10.0.15" />
    <PackageReference Include="Microsoft.Extensions.Configuration.CommandLine" Version="10.0.15" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.15" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
